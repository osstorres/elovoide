---
import Base from '../../../layouts/Base.astro';
import { getInjuries } from '../../../lib/content';
import { langPaths } from '../../../lib/paths';
import { t, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const reports = await getInjuries();
---
<Base lang={lang} title={t(lang, 'injuries.title')} description={t(lang, 'injuries.intro')}>
  <div class="container">
    <header class="page-head">
      <span class="kicker">El Ovoide</span>
      <h1>{t(lang, 'injuries.title')}</h1>
      <p>{t(lang, 'injuries.intro')}</p>
    </header>

    {reports.length ? (
      <div>
        {reports.map((r) => (
          <a class="week-card" href={`/${lang}/injuries/${r.id}`}>
            <span class="badge">{t(lang, 'picks.week')} {r.data.week} · {r.data.season}</span>
            <h3>{r.data.title}</h3>
            <span class="muted">{r.data.games.length} {t(lang, 'injuries.games')}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">{t(lang, 'injuries.empty')}</p>
    )}
  </div>
</Base>
