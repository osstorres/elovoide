---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PickCard from '../../../components/PickCard.astro';
import { resolvePicks, splitId, type PickEntry } from '../../../lib/content';
import { recordText } from '../../../lib/results';
import { t, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('picks', (e) => !e.data.draft);
  return entries.map((entry) => {
    const { lang, slug } = splitId(entry.id);
    return { params: { lang, slug }, props: { entry } };
  });
}

const lang = Astro.params.lang as Lang;
const { entry } = Astro.props as { entry: PickEntry };
const { Content } = await render(entry);
const { games, record } = await resolvePicks(entry);
const decided = record.win + record.loss + record.push;
---
<Base lang={lang} title={entry.data.title} description={entry.data.summary}>
  <div class="container">
    <header class="page-head">
      <a href={`/${lang}/picks`} class="back">← {t(lang, 'picks.back')}</a>
      <span class="kicker">{t(lang, 'picks.season')} {entry.data.season} · {t(lang, 'picks.week')} {entry.data.week}</span>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
    </header>

    <div class="stats-row">
      <div class="stat">
        <div class="label">{t(lang, 'picks.weekRecord')}</div>
        <div class="record-big">{decided ? recordText(record) : '—'}</div>
      </div>
      <div class="stat">
        <div class="label">{t(lang, 'picks.pending')}</div>
        <div class="record-big">{record.pending}</div>
      </div>
      <div class="stat">
        <div class="label">&nbsp;</div>
        <a href={`/${lang}/scores#week=${entry.data.week}`}>{t(lang, 'scores.title')} de la semana →</a>
      </div>
    </div>

    <div class="prose"><Content /></div>

    <section class="section">
      {games.map((game) => <PickCard lang={lang} game={game} />)}
    </section>
  </div>
</Base>
