---
import Base from '../../layouts/Base.astro';
import { langPaths } from '../../lib/paths';
import { t, type Lang } from '../../i18n/ui';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
// Under construction: the memes collection (src/content/memes) stays in the repo, it just isn't rendered.
---
<Base lang={lang} title={t(lang, 'memes.title')} description={t(lang, 'memes.construction')}>
  <div class="container">
    <header class="page-head">
      <span class="kicker">El Ovoide</span>
      <h1>{t(lang, 'memes.title')}</h1>
      <p>{t(lang, 'memes.construction')}</p>
    </header>
  </div>
</Base>
