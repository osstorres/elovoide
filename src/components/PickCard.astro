---
import OutcomeBadge from './OutcomeBadge.astro';
import { logoFor } from '../lib/espn';
import { teamName } from '../lib/teams';
import type { ResolvedGame } from '../lib/content';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang; game: ResolvedGame }
const { lang, game: g } = Astro.props;
const hasScore = g.awayScore !== null && g.homeScore !== null;
---
<article class="pick">
  <header class="pick-head">
    <div class="matchup">
      <img src={logoFor(g.away)} alt="" width="26" height="26" loading="lazy" />
      <span>{g.away}{hasScore && ` ${g.awayScore}`}</span>
      <span class="at">@</span>
      <span>{hasScore && `${g.homeScore} `}{g.home}</span>
      <img src={logoFor(g.home)} alt="" width="26" height="26" loading="lazy" />
    </div>
    <OutcomeBadge lang={lang} outcome={g.outcome} />
  </header>
  <div class="pick-choice">
    <span>{t(lang, 'picks.pick')}: <strong>{teamName(g.pick)}</strong></span>
    {g.spread && <span class="muted">{t(lang, 'picks.spread')}: {g.spread}</span>}
  </div>
  {g.analysis ? (
    <div>
      <h4>{t(lang, 'picks.analysis')}</h4>
      <p>{g.analysis}</p>
    </div>
  ) : (
    <p class="placeholder">{t(lang, 'picks.analysisPending')}</p>
  )}
  {g.context && (
    <div>
      <h4>{t(lang, 'picks.context')}</h4>
      <p>{g.context}</p>
    </div>
  )}
  {g.data.length > 0 && <ul class="data-list">{g.data.map((d) => <li>{d}</li>)}</ul>}
  {g.note && <p class="result-note">{g.note}</p>}
</article>
